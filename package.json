{
  "name": "SMeS",
  "version": "1.0.0",
  "description": "SMeS: a student meal coupon system (frontend + tests)",
  "private": true,
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "server": "npm start --prefix server"
  },
  "license": "MIT",
  "devDependencies": {
    "@babel/preset-env": "^7.25.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "js/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 60,
        "statements": 60,
        "functions": 60,
        "branches": 40
      }
    }
  }
}
